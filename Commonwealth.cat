          <selectionEntries>
            <selectionEntry name="CRYOSHOCK" id="4ba1-6980-219e-5505" hidden="true" import="true" sortIndex="7" type="upgrade">
              <constraints>
                <constraint id="6a0c-c809-e3cf-ffa8" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
