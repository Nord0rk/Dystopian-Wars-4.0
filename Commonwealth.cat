      <rules>
        <rule name="Zaporozhian Spirit" id="5497-f911-ada5-863a" hidden="false">
          <description>When a Ukrainian Underwater unit in this Force makes an Attack action, its Admiral can discard a Victory &amp; Valour Card before any dice are rolled.


If they do so, the Action Roll is unaffected by Disorder.</description>
        </rule>
      </rules>
