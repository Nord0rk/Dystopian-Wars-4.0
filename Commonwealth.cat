          <selectionEntries>
            <selectionEntry name="CRYOSHOCK" id="66e5-0a5a-747a-c570" hidden="true" import="true" sortIndex="7" type="upgrade">
              <constraints>
                <constraint id="cba8-02b1-27c8-5657" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
