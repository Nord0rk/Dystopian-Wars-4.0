          <selectionEntries>
            <selectionEntry name="CRYOSHOCK" id="c8e1-513f-8a91-5a94" hidden="true" import="true" sortIndex="7" type="upgrade">
              <constraints>
                <constraint id="a97e-4977-e93a-d6c1" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
