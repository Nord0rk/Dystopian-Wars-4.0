                <cost name="VP" typeId="c245-c6fc-adb8-407a" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditionGroups>
                    <conditionGroup max="2" min="2" type="count">
                      <conditions>
                        <condition childId="0ec6-f5c8-25d7-89d8" field="selections" scope="0ec6-f5c8-25d7-89d8" shared="true" type="atLeast" value="1"/>
                        <condition childId="f625-fe99-41c1-ff3d" field="selections" scope="0ec6-f5c8-25d7-89d8" shared="true" type="atLeast" value="1"/>
