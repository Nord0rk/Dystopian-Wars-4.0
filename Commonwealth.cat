                  <conditionGroups>
                    <conditionGroup min="2" type="count">
                      <conditions>
                        <condition childId="0ec6-f5c8-25d7-89d8" field="selections" scope="0ec6-f5c8-25d7-89d8" shared="true" type="atLeast" value="1"/>
                        <condition childId="f421-3280-3483-3214" field="selections" scope="0ec6-f5c8-25d7-89d8" shared="true" type="atLeast" value="1"/>
