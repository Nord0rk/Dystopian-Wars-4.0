      <rules>
        <rule name="The Giant’s Breath" id="cb22-0510-cdd3-c140" hidden="false">
          <description>When making an Attack action in which at least one Participating Commonwealth Light Vessel model is within 6” of at least one friendly Commonwealth Colossus unit, any Blanks and Standard Counters in the Action Roll can be re-rolled. Attachments cannot trigger this Bonus.</description>
        </rule>
      </rules>
