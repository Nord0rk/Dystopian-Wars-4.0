                        <condition childId="4521-8e16-2d0f-7dc6" field="selections" scope="0ec6-f5c8-25d7-89d8" shared="true" type="atLeast" value="1"/>
                        <condition childId="4521-8e16-2d0f-7dc6" field="selections" scope="8788-012d-a112-2ccf" shared="true" type="atLeast" value="1"/>
                        <condition childId="0ec6-f5c8-25d7-89d8" field="selections" scope="e59f-af2b-c23a-79d8" shared="true" type="atLeast" value="1"/>
