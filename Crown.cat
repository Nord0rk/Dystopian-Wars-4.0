      <rules>
        <rule name="Lionhearted Crew" id="a4a3-d23e-67b3-ef6e" hidden="false">
          <description>When making a Crew Check or Group Crew Check for a Crown unit, this Admiral can discard a Victory &amp; Valour Card from their hand instead of drawing the top card of their deck.


The Value of the card they discard is used for the Crew Check.</description>
        </rule>
      </rules>
    </forceEntry>
