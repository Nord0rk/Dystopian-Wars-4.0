            <cost name="Points" typeId="89fa-eeaa-958f-ca32" value="30"/>
            <cost name="VP" typeId="c245-c6fc-adb8-407a" value="0"/>
          </costs>
          <rules>
            <rule name="Flenser Torpedoes" id="2bb6-d302-5dec-f97a" hidden="false">
              <description>Once per Round, when a unit from this Force makes an Attack action and there is at least one Contributing weapon with the Torpedo quality, the Admiral can discard a Victory &amp; Valour Card from their hand before making the Action Roll.


If they do so, they can re-roll any Blank results in the Action Roll.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Additional Incendiaries Injection" id="b204-d94c-41de-62d4" hidden="false" import="true" sortIndex="1" type="upgrade">
