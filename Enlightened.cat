      <selectionEntries>
        <selectionEntry name="Flenser Torpedoes" id="6f67-cf13-df3f-b0db" hidden="false" import="true" sortIndex="14" type="upgrade">
          <comment>1</comment>
          <constraints>
            <constraint id="86b3-5310-ee40-da0d" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
