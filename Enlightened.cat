              <conditionGroups>
                <conditionGroup type="and">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition childId="e3c8-cdc8-2eb6-6efa" childName="The Respect Of Meritocratic Rank" field="selections" scope="parent" shared="true" type="equalTo" value="1"/>
