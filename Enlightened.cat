          <rules>
            <rule name="Physeter Echo Communicators" id="b9f0-29f3-1216-62cd" hidden="false">
              <description>At the end of the Deployment step, this Admiral gains 6 Physeter Construct tokens.


They can then allocate these Tokens between the units in their Force, with a maximum of 3 Tokens per unit.</description>
            </rule>
          </rules>
        </selectionEntry>
