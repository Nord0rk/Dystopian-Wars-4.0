                <cost name="VP per Model" typeId="c245-c6fc-adb8-407a" value="0"/>
              </costs>
              <rules>
                <rule name="PEERLESS DISCIPLINE" id="9f7d-2370-aab5-7b2f" hidden="false">
                  <description>Once per Round, during the Resolve Re-rolls step of an Action Roll Action Roll this Admiral is making for a unit in their Force, they can discard a Victory &amp; Valour Card Victory &amp; Valour Card from their hand. If they do so, the Admiral can re-roll any number of dice in the pool. They can only do this if the unit making the Action Roll either is a Flagship Flagship, or is within 1010”” of a friendly Flagship Flagship.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </entryLink>
